# Token del bot, lo da @BotFather. Obligatorio, no tiene default.
TELEGRAM_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Ruta del archivo SQLite. Opcional, default "turnos.db".
TURNOSBOT_DB_PATH=turnos.db

# Nivel de logging. Opcional, default INFO.
LOG_LEVEL=INFO

# Ruta de archivo de log con rotación. Opcional, si no se setea solo loguea por consola.
LOG_FILE=turnosbot.log
